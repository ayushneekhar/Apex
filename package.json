{
  "name": "apex",
  "main": "index.js",
  "version": "1.1.1",
  "scripts": {
    "start": "react-native start",
    "prebuild": "expo prebuild",
    "android": "NODE_ENV=development expo run:android",
    "android:apk:debug": "cd android && NODE_ENV=development ./gradlew assembleDebug",
    "android:apk:release": "cd android && NODE_ENV=production ./gradlew assembleRelease",
    "android:aab:release": "cd android && NODE_ENV=production ./gradlew :app:bundleRelease",
    "android:standalone:build": "cd android && NODE_ENV=production ./gradlew assembleRelease",
    "android:standalone:install": "cd android && NODE_ENV=production ./gradlew installRelease",
    "ios": "NODE_ENV=development expo run:ios",
    "ios:release": "NODE_ENV=production expo run:ios --configuration Release",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "ad": "./scripts/agent-device.sh",
    "ad:devices": "./scripts/agent-device.sh devices",
    "ad:ios:boot": "./scripts/agent-device.sh boot --platform ios",
    "ad:ios:open": "./scripts/agent-device.sh open com.neekhar.apex --platform ios",
    "ad:ios:reinstall": "./scripts/agent-device-ios-reinstall.sh",
    "ad:android:boot": "./scripts/agent-device.sh boot --platform android",
    "ad:android:open": "./scripts/agent-device.sh open com.neekhar.apex --platform android",
    "ad:android:reinstall": "./scripts/agent-device-android-reinstall.sh",
    "nitro-ota:build": "node scripts/ota/build-nitro-ota.mjs",
    "version:app:bump": "node scripts/version/bump-app-version.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/unbounded": "^0.4.1",
    "@expo/vector-icons": "^15.1.1",
    "@react-navigation/bottom-tabs": "^7.19.2",
    "@react-navigation/native": "^7.4.1",
    "@react-navigation/native-stack": "^7.19.2",
    "@shopify/react-native-skia": "2.6.2",
    "expo": "~57.0.25",
    "expo-auth-session": "~57.0.13",
    "expo-blur": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-linear-gradient": "~57.0.2",
    "expo-notifications": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-nitro-haptics": "^0.2.3",
    "react-native-nitro-modules": "0.35.1",
    "react-native-nitro-ota": "0.14.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "victory-native": "42.0.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@react-native-community/cli": "^20.2.0",
    "@react-native/metro-config": "0.86.3",
    "@types/react": "~19.2.4",
    "babel-plugin-module-resolver": "^5.0.3",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  },
  "private": true
}
